<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.xlqs.com.example.mapper.UserDao">

    <resultMap id="BaseResultMap" type="org.xlqs.com.example.dto.UserDto">
            <id property="id" column="id" />
            <result property="userId" column="user_id" />
            <result property="name" column="name" />
            <result property="email" column="email" />
            <result property="phone" column="phone" />
            <result property="address" column="address" />
            <result property="createdAt" column="created_at" />
            <result property="updatedAt" column="updated_at" />
            <result property="hobby" column="hobby" />
            <result property="job" column="job" />
    </resultMap>

<!--    <sql id="Base_Column_List">-->
<!--        id,user_id,name,email,phone,address,-->
<!--        created_at,updated_at,hobby,job-->
<!--    </sql>-->
    <select id="findById" resultType="org.xlqs.com.example.dto.UserDto">
        select * from "user" where id = #{id}
    </select>
</mapper>
